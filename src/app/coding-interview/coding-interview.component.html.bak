<main class="shell route-shell p-4">
  <div *ngIf="errorMessage" class="banner error p-2 bg-red-100 text-red-700 rounded mb-4">{{ errorMessage }}</div>
  <div *ngIf="successMessage" class="banner success p-2 bg-green-100 text-green-700 rounded mb-4">{{ successMessage }}</div>

  <!-- Loading State -->
  <div *ngIf="!ready" class="text-gray-500">Loading session...</div>

  <!-- Auth Wall -->
  <section *ngIf="ready && !isAuthenticated" class="route-hero p-8 bg-gray-50 rounded shadow">
    <p class="eyebrow text-sm uppercase text-gray-500 font-semibold mb-2">Coding Test Hub</p>
    <h1 class="text-3xl font-bold mb-4">This workspace needs an authenticated session.</h1>
    <p class="hero-copy mb-6 text-gray-700">Please log in first before attempting a customized Coding workspace interview.</p>
    <div class="hero-links">
      <button class="primary-button link-button px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" (click)="openLoginDialog()">Go to Login</button>
    </div>
  </section>

  <ng-container *ngIf="ready && isAuthenticated">
    
    <!-- State 1: Setup View -->
    <article *ngIf="!activeInterviewId" class="card stack-card p-6 bg-white rounded shadow mx-auto overflow-visible relative z-50" style="max-width: 680px; width: 100%;">
      <div class="card-heading mb-6">
        <p class="eyebrow text-sm uppercase text-gray-500 font-semibold mb-1">Coding Interview Sandbox</p>
        <h2 class="text-2xl font-bold mb-2">Start a coding round</h2>
        <p class="muted-copy text-gray-600">Simulate standard output prediction, time/space complexity calculations, or multi-phase LeetCode-style interviews.</p>
      </div>

      <form class="flex flex-col gap-4" (ngSubmit)="handleStartCodingSession()">
        
        <label class="field flex flex-col gap-1">
          <span class="font-medium text-gray-700">Select Technology Stack</span>
          <select class="p-2 border rounded" [(ngModel)]="topic" name="topic">
            <option *ngFor="let t of topics" [value]="t.name">{{ t.name }}</option>
          </select>
        </label>

        <div class="field flex flex-col gap-1">
          <span class="font-medium text-gray-700">Difficulty Level</span>
          <div class="flex gap-2 flex-wrap mt-1">
            <button *ngFor="let lvl of difficultyLevels" type="button" 
                    (click)="difficulty = lvl"
                    class="px-4 py-2 text-sm rounded border cursor-pointer transition-colors"
                    [ngClass]="difficulty === lvl ? 'border-blue-500 bg-blue-50 text-blue-700' : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'">
              {{ lvl.replace('_', ' ') }}
            </button>
          </div>
          <!-- Manipulation Setup -->
          <div *ngIf="difficulty === 'MANIPULATION CHALLENGE'" class="mt-4 p-4 bg-gray-50 rounded border">
            <h3 class="font-bold mb-3 text-gray-700">Manipulation Options</h3>
            <div class="mb-3">
              <label class="block text-sm font-semibold mb-1 text-gray-700">Select Category</label>
              <select [(ngModel)]="selectedManipulationCategory" (change)="fetchSavedSets()" class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500" name="manipCat">
                <option *ngFor="let cat of manipulationCategories" [value]="cat.name">{{ cat.name }}</option>
              </select>
            </div>
            
            <div class="mb-3">
              <label class="block text-sm font-semibold mb-1 text-gray-700">Question Set</label>
              <select [(ngModel)]="selectedSavedSetId" class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500" name="savedSet">
                <option value="NEW">Generate New AI Set</option>
                <option value="NEXT">Generate Next AI Set (Exclude Previous)</option>
                <optgroup *ngIf="savedQuestionSets && savedQuestionSets.length > 0" label="Saved Question Sets">
                  <option *ngFor="let set of savedQuestionSets" [value]="set.id">{{ set.setName }}</option>
                </optgroup>
              </select>
            </div>

            <div *ngIf="userHistory && userHistory.length > 0" class="mb-3 pt-3 border-t">
              <label class="block text-sm font-semibold mb-1 text-gray-700">Revisit Previous Attempts</label>
              <div class="flex gap-2">
                <select [(ngModel)]="selectedHistoryId" class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500" name="historySet">
                  <option value="">-- Select a past attempt --</option>
                  <option *ngFor="let h of userHistory" [value]="h.id">
                    {{ h.topic }} - Score: {{ h.score }}/100 ({{ h.date | date:'MMM d, y' }})
                  </option>
                </select>
                <button (click)="handleRevisitAttempt()" [disabled]="!selectedHistoryId" type="button" class="bg-indigo-600 text-white px-4 py-2 rounded font-bold hover:bg-indigo-700 transition disabled:opacity-50">
                  Re-attempt
                </button>
              </div>
            </div>

            <div class="flex items-center gap-2 mt-4 pt-4 border-t">
              <input type="text" [(ngModel)]="newCategoryName" placeholder="New Category Name" class="flex-1 p-2 border rounded" name="newCat">
              <button (click)="handleAddCategory()" type="button" class="bg-blue-600 text-white px-4 py-2 rounded font-bold hover:bg-blue-700 transition">
                Add Category
              </button>
            </div>
          </div>
        </div>

        <!-- Complexity Setup -->
        <div *ngIf="difficulty === 'COMPLEXITY'" class="mt-4 p-4 bg-gray-50 rounded border">
          <h3 class="font-bold mb-3 text-gray-700">Complexity Options</h3>
          <div class="mb-3">
            <label class="block text-sm font-semibold mb-1 text-gray-700">Select Category</label>
            <select [(ngModel)]="selectedComplexityCategory" (change)="fetchSavedComplexitySets()" class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500" name="compCat">
              <option *ngFor="let cat of complexityCategories" [value]="cat.name">{{ cat.name }}</option>
            </select>
          </div>
          
          <div class="mb-3">
            <label class="block text-sm font-semibold mb-1 text-gray-700">Question Set</label>
            <select [(ngModel)]="selectedSavedComplexitySetId" class="w-full p-2 border rounded focus:ring-2 focus:ring-blue-500" name="savedCompSet">
              <option value="NEW">Generate New AI Set</option>
              <option value="NEXT">Generate Next AI Set (Exclude Previous)</option>
              <optgroup *ngIf="savedComplexitySets && savedComplexitySets.length > 0" label="Saved Question Sets">
                <option *ngFor="let set of savedComplexitySets" [value]="set.id">{{ set.setName }}</option>
              </optgroup>
            </select>
          </div>
        </div>

        <label *ngIf="difficulty !== 'MANIPULATION CHALLENGE' && difficulty !== 'COMPLEXITY'" class="field flex flex-col gap-1">
          <span class="font-medium text-gray-700">Custom Specifications (Optional)</span>
          <textarea class="p-3 border rounded resize-y" [(ngModel)]="customDescription" name="customDescription"
                    placeholder="e.g. Focus on recursive algorithms, bitwise logic, or scenario based data trees."
                    rows="3"></textarea>
        </label>

        <button class="primary-button px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 mt-2 font-semibold" 
                [disabled]="!!busyLabel" type="submit">
          {{ getSubmitButtonText() }}
        </button>
      </form>
    </article>

    <!-- State 2: Active Coding Workspace -->
    <div *ngIf="manipulationQuestions.length > 0 && currentPhase !== 'COMPLETED'" class="mx-auto max-w-4xl w-full flex flex-col gap-6">
      <div class="flex justify-between items-center bg-white p-4 rounded shadow">
        <div>
          <h2 class="text-2xl font-bold flex items-center gap-3">
            Manipulation Challenge
            <span *ngIf="activeSetName" class="text-sm bg-indigo-100 text-indigo-800 border border-indigo-200 px-3 py-1 rounded-full font-semibold shadow-sm">
              Active Set: {{ activeSetName }}
            </span>
            <button *ngIf="!isCurrentSetSaved" (click)="saveCurrentManipulationSet()" class="text-sm bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded shadow transition font-semibold">
              Save Question Set
            </button>
            <span *ngIf="isCurrentSetSaved" class="text-sm text-green-600 font-semibold flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Questions are saved with the name '{{ activeSetName }}'
            </span>
          </h2>
          <p class="text-gray-600">Topic: {{ topic }} | Category: {{ selectedManipulationCategory }}</p>
        </div>
        <button class="text-red-500 hover:text-red-700 font-medium text-sm border border-red-200 px-3 py-1 rounded" (click)="handleReset()">Exit Challenge</button>
      </div>

      <article *ngFor="let q of manipulationQuestions; let i = index" class="card p-5 bg-white rounded shadow">
        <div class="flex justify-between items-start mb-3">
          <h3 class="text-lg font-bold text-blue-800">Question {{ i + 1 }}</h3>
          <button (click)="copyToClipboard(q.question)" class="text-gray-500 hover:text-blue-600 transition-colors p-1 rounded focus:outline-none focus:ring-2 focus:ring-blue-300" title="Copy Question">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>
        <p class="text-gray-800 mb-4">{{ q.question }}</p>
        
        <div class="flex justify-between items-center mb-2">
          <h4 class="font-semibold text-sm text-indigo-700">Your Approach / Steps</h4>
          <button (click)="showHint(i)" *ngIf="!manipulationHintVisible[i]" class="text-xs bg-yellow-100 hover:bg-yellow-200 text-yellow-800 font-bold py-1 px-3 rounded shadow-sm border border-yellow-300 transition-colors flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Reveal Hint (Pseudo-code)
          </button>
          <span *ngIf="manipulationHintVisible[i]" class="text-xs font-bold text-red-600 animate-pulse flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Hiding in {{ manipulationHintTimeRemaining[i] }}s...
          </span>
        </div>
        
        <div *ngIf="manipulationHintVisible[i]" class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4 rounded shadow-inner overflow-x-auto transition-all duration-500 ease-in-out">
          <h5 class="text-xs uppercase font-bold text-yellow-800 mb-2 tracking-wider">AI Generated Pseudo-code</h5>
          <pre class="text-sm font-mono text-gray-800 whitespace-pre-wrap">{{ q.hint }}</pre>
        </div>
        <textarea class="w-full p-4 border rounded font-mono text-sm bg-gray-50 h-24 mb-4" 
                  [(ngModel)]="manipulationApproaches[i]" 
                  placeholder="Explain your logic, edge cases, and steps..."
                  spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>

        <h4 class="font-semibold text-sm mb-2 text-blue-700">Your Code</h4>
        <textarea class="w-full p-4 border rounded font-mono text-sm bg-gray-50 h-32" 
                  [(ngModel)]="manipulationAnswers[i]" 
                  placeholder="Write your code here..."
                  spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
      </article>

      <button class="w-full py-4 bg-green-600 text-white font-bold text-xl rounded shadow hover:bg-green-700 transition"
              (click)="handleSubmitManipulationAnswers()" [disabled]="!!busyLabel">
        {{ busyLabel || 'Submit All 10 Answers for Evaluation' }}
      </button>
    </div>

    <!-- State 2.5: Active Complexity Workspace -->
    <div *ngIf="complexityQuestions.length > 0 && currentPhase !== 'COMPLETED'" class="mx-auto max-w-4xl w-full flex flex-col gap-6">
      <div class="flex justify-between items-center bg-white p-4 rounded shadow">
        <div>
          <h2 class="text-2xl font-bold flex items-center gap-3">
            Complexity Challenge
            <span *ngIf="activeSetName" class="text-sm bg-indigo-100 text-indigo-800 border border-indigo-200 px-3 py-1 rounded-full font-semibold shadow-sm">
              Active Set: {{ activeSetName }}
            </span>
            <button *ngIf="!isCurrentSetSaved" (click)="saveCurrentComplexitySet()" class="text-sm bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded shadow transition font-semibold">
              Save Question Set
            </button>
            <span *ngIf="isCurrentSetSaved" class="text-sm text-green-600 font-semibold flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Questions are saved with the name '{{ activeSetName }}'
            </span>
          </h2>
          <p class="text-gray-600">Topic: {{ topic }} | Category: {{ selectedComplexityCategory }}</p>
        </div>
        <button class="text-red-500 hover:text-red-700 font-medium text-sm border border-red-200 px-3 py-1 rounded" (click)="handleReset()">Exit Challenge</button>
      </div>

      <article *ngFor="let q of complexityQuestions; let i = index" class="card p-5 bg-white rounded shadow">
        <div class="flex justify-between items-start mb-3">
          <h3 class="text-lg font-bold text-blue-800">Question {{ i + 1 }}</h3>
          <button (click)="copyToClipboard(q)" class="text-gray-500 hover:text-blue-600 transition-colors p-1 rounded focus:outline-none focus:ring-2 focus:ring-blue-300" title="Copy Question">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>
        </div>
        <div class="markdown-body text-gray-800 mb-4 block">
          <markdown [data]="q"></markdown>
        </div>
        
        <h4 class="font-semibold text-sm mb-2 text-blue-700">Your Answer</h4>
        <textarea class="w-full p-4 border rounded font-mono text-sm bg-gray-50 h-24" 
                  [(ngModel)]="complexityAnswers[i]" 
                  placeholder="Provide time and space complexity and a brief explanation..."
                  spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"></textarea>
      </article>

      <button class="w-full py-4 bg-green-600 text-white font-bold text-xl rounded shadow hover:bg-green-700 transition"
              (click)="handleSubmitComplexityAnswers()" [disabled]="!!busyLabel">
        {{ busyLabel || 'Submit All 10 Answers for Evaluation' }}
      </button>
    </div>

    <div *ngIf="activeInterviewId && currentPhase !== 'COMPLETED'" 
         class="grid grid-cols-1 lg:grid-cols-2 gap-6 min-h-[calc(100vh-200px)]">
      
      <!-- Left Panel: Description & Actions -->
      <div class="flex flex-col gap-5">
        <article class="card p-6 bg-white rounded shadow flex flex-col overflow-y-auto max-h-[700px]">
          <div class="flex justify-between items-center border-b pb-3 mb-4">
            <div>
              <span class="px-2 py-1 bg-blue-600 text-white text-xs font-bold rounded">Difficulty: {{ difficulty }}</span>
              <span class="px-2 py-1 bg-gray-200 text-gray-700 text-xs font-bold rounded ml-2">Topic: {{ topic }}</span>
            </div>
            <div class="flex items-center gap-3">
              <button (click)="copyToClipboard(questionText)" class="text-gray-500 hover:text-blue-600 transition-colors p-1 rounded focus:outline-none focus:ring-2 focus:ring-blue-300" title="Copy Question">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
              <button class="text-red-500 hover:text-red-700 font-medium text-sm" (click)="handleReset()">Exit</button>
            </div>
          </div>

          <div class="markdown-body leading-relaxed prose prose-sm max-w-none text-gray-800">
            <markdown [data]="questionText"></markdown>
          </div>
        </article>

        <!-- Approach Input Block -->
        <article *ngIf="currentPhase === 'APPROACH'" class="card p-5 bg-white rounded shadow">
          <h3 class="text-lg font-bold mb-2">Step 1: Explain Your Approach</h3>
          <p class="text-sm text-gray-600 mb-4">Briefly explain your strategy, time & space complexities. AI will review it before approving coding access.</p>

          <form (ngSubmit)="handleSubmitApproach()" class="flex flex-col gap-3">
            <textarea class="p-3 border rounded w-full" rows="4" [(ngModel)]="approachText" name="approachText"
                      placeholder="e.g. I will use a two-pointer technique to swap characters, achieving O(N) time and O(1) auxiliary space."
                      required></textarea>

            <div *ngIf="approachFeedback" class="p-3 rounded text-sm mt-1 border"
                 [ngClass]="approachApproved ? 'border-green-300 bg-green-50 text-green-800' : 'border-red-300 bg-red-50 text-red-800'">
              <strong>Interviewer Critique:</strong> {{ approachFeedback }}
            </div>

            <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 font-semibold self-start" 
                    type="submit" [disabled]="!!busyLabel">
              {{ busyLabel || 'Submit Approach' }}
            </button>
          </form>
        </article>
      </div>

      <!-- Right Panel: Code Workspace -->
      <div class="flex flex-col h-full">
        <!-- Super Easy & Easy Input Console -->
        <article *ngIf="difficulty === 'SUPER_EASY' || difficulty === 'COMPLEXITY'" class="card p-6 bg-white rounded shadow flex flex-col justify-center h-full">
          <h3 class="text-xl font-bold mb-3">Write Your Answer</h3>
          <p class="text-gray-600 mb-4">Trace the output or complexity and write your final conclusion below.</p>
          <form (ngSubmit)="handleSubmitDirectAnswer()" class="flex flex-col gap-4 h-full">
            <textarea class="p-4 border rounded flex-1 resize-none" [(ngModel)]="directAnswer" name="directAnswer"
                      placeholder="Provide your exact output, calculations, or explanations..." required></textarea>
            <button class="px-4 py-3 bg-blue-600 text-white rounded hover:bg-blue-700 font-bold" 
                    type="submit" [disabled]="!!busyLabel">
              {{ busyLabel || 'Submit Answer' }}
            </button>
          </form>
        </article>

        <!-- Monaco Editor Split Workspace -->
        <article *ngIf="difficulty !== 'SUPER_EASY' && difficulty !== 'COMPLEXITY'" class="card p-3 bg-white rounded shadow flex flex-col h-full min-h-[500px]">
          <div class="flex justify-between items-center mb-3 px-2">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium">Select Language:</span>
              <select class="p-1 border rounded bg-gray-50 text-sm" [value]="selectedLanguage" (change)="handleLanguageChange($event)">
                <option value="javascript">JavaScript</option>
                <option value="java">Java</option>
              </select>
            </div>
            <button class="text-gray-500 hover:text-gray-700 text-sm" (click)="handleLanguageChange({target: {value: selectedLanguage}})">Reset Code</button>
          </div>

          <div class="flex-1 border rounded overflow-hidden">
            <ngx-monaco-editor class="w-full h-full min-h-[450px]" [options]="editorOptions" [(ngModel)]="userCode"></ngx-monaco-editor>
          </div>

          <div class="flex justify-end mt-4 px-2">
            <button class="px-5 py-2 bg-green-700 text-white font-bold rounded hover:bg-green-800" 
                    (click)="handleSubmitCode()" [disabled]="!!busyLabel">
              {{ busyLabel || 'Submit Code Solution' }}
            </button>
          </div>
        </article>
      </div>
    </div>

    <!-- State 3: Final Grading / Scorecard View -->
    <div *ngIf="currentPhase === 'COMPLETED'" class="flex flex-col gap-6 mx-auto max-w-4xl w-full">
      
      <!-- Manipulation Scorecard -->
      <ng-container *ngIf="manipulationResult">
        <article class="card p-10 bg-white rounded shadow text-center">
          <p class="text-gray-500 uppercase font-bold text-sm tracking-widest mb-6">Manipulation Evaluation Scorecard</p>
          <div class="mx-auto w-40 h-40 rounded-full border-[10px] border-gray-100 bg-gray-50 flex items-center justify-center mb-6 shadow-inner">
            <div>
              <div class="text-5xl font-black text-gray-800">{{ manipulationResult.total_score }}</div>
              <div class="text-sm text-gray-500 mt-1">out of 100</div>
            </div>
          </div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2">
            Manipulation Challenge: {{ selectedManipulationCategory }}
          </h2>
          <button class="mt-6 px-6 py-2 bg-blue-600 text-white font-semibold rounded hover:bg-blue-700" (click)="handleReset()">
            Try Another Challenge
          </button>
        </article>

        <article *ngFor="let eval of manipulationResult.evaluations; let i = index" class="card p-6 bg-white rounded shadow border-l-4 border-blue-500">
          <div class="flex justify-between items-start mb-3">
            <h3 class="text-lg font-bold text-gray-800">Question {{ i + 1 }}</h3>
            <span class="px-3 py-1 bg-green-100 text-green-800 font-bold rounded shadow-sm text-sm">
              Score: {{ eval.score }} / 10 
              <span class="text-gray-600 font-normal ml-1 border-l pl-2 border-green-300">(Approach: {{ eval.approach_score || 0 }}/4 | Code: {{ eval.code_score || 0 }}/6)</span>
            </span>
          </div>
          <p class="text-gray-800 mb-4 bg-gray-50 p-4 rounded text-sm border font-medium">{{ eval.question }}</p>
          
          <div class="mb-4">
            <h4 class="font-bold text-gray-700 mb-2">Your Approach</h4>
            <pre class="bg-gray-100 text-gray-800 border p-4 rounded text-sm font-mono whitespace-pre-wrap overflow-x-auto shadow-inner mb-4">{{ manipulationApproaches[i] || 'No approach provided' }}</pre>

            <h4 class="font-bold text-gray-700 mb-2">Your Code</h4>
            <pre class="bg-gray-800 text-green-400 p-4 rounded text-sm font-mono whitespace-pre-wrap overflow-x-auto shadow-inner">{{ manipulationAnswers[i] || 'No code provided' }}</pre>
          </div>

          <div class="border-t border-gray-200 pt-4">
            <h4 class="font-bold text-gray-700 mb-2 flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              AI Feedback
            </h4>
            <p class="text-gray-600 leading-relaxed bg-blue-50 p-3 rounded">{{ eval.feedback }}</p>
          </div>
        </article>
      </ng-container>

      <!-- Complexity Scorecard -->
      <ng-container *ngIf="complexityResult">
        <article class="card p-10 bg-white rounded shadow text-center">
          <p class="text-gray-500 uppercase font-bold text-sm tracking-widest mb-6">Complexity Evaluation Scorecard</p>
          <div class="mx-auto w-40 h-40 rounded-full border-[10px] border-gray-100 bg-gray-50 flex items-center justify-center mb-6 shadow-inner">
            <div>
              <div class="text-5xl font-black text-gray-800">{{ complexityResult.total_score }}</div>
              <div class="text-sm text-gray-500 mt-1">out of 100</div>
            </div>
          </div>
          <h2 class="text-2xl font-bold mb-6 text-gray-800 border-b pb-2">
            Complexity Challenge: {{ selectedComplexityCategory }}
          </h2>
          <button class="mt-6 px-6 py-2 bg-blue-600 text-white font-semibold rounded hover:bg-blue-700" (click)="handleReset()">
            Try Another Challenge
          </button>
        </article>

        <article *ngFor="let eval of complexityResult.evaluations; let i = index" class="card p-6 bg-white rounded shadow border-l-4 border-blue-500">
          <div class="flex justify-between items-start mb-3">
            <h3 class="text-lg font-bold text-gray-800">Question {{ i + 1 }}</h3>
            <span class="px-3 py-1 bg-green-100 text-green-800 font-bold rounded shadow-sm text-sm">
              Score: {{ eval.score }} / 10 
            </span>
          </div>
          <div class="markdown-body text-gray-800 mb-4 bg-gray-50 p-4 rounded text-sm border font-medium block">
            <markdown [data]="eval.question"></markdown>
          </div>
          
          <div class="mb-4">
            <h4 class="font-bold text-gray-700 mb-2">Your Answer</h4>
            <pre class="bg-gray-100 text-gray-800 border p-4 rounded text-sm font-mono whitespace-pre-wrap overflow-x-auto shadow-inner mb-4">{{ complexityAnswers[i] || 'No answer provided' }}</pre>
          </div>

          <div class="border-t border-gray-200 pt-4">
            <h4 class="font-bold text-gray-700 mb-2 flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              AI Feedback
            </h4>
            <p class="text-gray-600 leading-relaxed bg-blue-50 p-3 rounded">{{ eval.feedback }}</p>
          </div>
        </article>
      </ng-container>

      <!-- Direct Answer Scorecard -->
      <article *ngIf="directResult" class="card p-10 bg-white rounded shadow text-center">
        <p class="text-gray-500 uppercase font-bold text-sm tracking-widest mb-6">Evaluation Result</p>
        <div class="mx-auto w-40 h-40 rounded-full border-[10px] border-gray-100 bg-gray-50 flex items-center justify-center mb-6 shadow-inner">
          <div>
            <div class="text-5xl font-black text-gray-800">{{ directResult.score }}</div>
            <div class="text-sm text-gray-500 mt-1">out of 100</div>
          </div>
        </div>
        <div class="text-left p-5 rounded bg-gray-50 border mt-6">
          <strong class="text-gray-800">Explanation:</strong>
          <p class="mt-2 leading-relaxed whitespace-pre-wrap text-gray-700">{{ directResult.explanation }}</p>
        </div>
        <button class="mt-8 px-6 py-2 bg-blue-600 text-white font-semibold rounded hover:bg-blue-700" (click)="handleReset()">
          Try Another Challenge
        </button>
      </article>

      <!-- Code Submission Scorecard -->
      <ng-container *ngIf="codingResult">
        <article class="card p-10 bg-white rounded shadow text-center">
          <p class="text-gray-500 uppercase font-bold text-sm tracking-widest mb-6">Submission Scorecard</p>
          <div class="mx-auto w-40 h-40 rounded-full border-[10px] border-gray-100 bg-gray-50 flex items-center justify-center mb-6 shadow-inner">
            <div>
              <div class="text-5xl font-black text-gray-800">{{ codingResult.score }}</div>
              <div class="text-sm text-gray-500 mt-1">out of 100</div>
            </div>
          </div>
          <button class="mt-6 px-6 py-2 bg-blue-600 text-white font-semibold rounded hover:bg-blue-700" (click)="handleReset()">
            Try Another Challenge
          </button>
        </article>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <article class="card p-6 bg-white rounded shadow">
            <h3 class="text-lg font-bold text-green-700 mb-3 border-b pb-2">Strengths</h3>
            <ul class="list-disc pl-5 leading-relaxed text-gray-700">
              <li *ngFor="let str of codingResult.strengths">{{ str }}</li>
            </ul>
          </article>

          <article class="card p-6 bg-white rounded shadow">
            <h3 class="text-lg font-bold text-red-700 mb-3 border-b pb-2">Weaknesses & Concerns</h3>
            <ul class="list-disc pl-5 leading-relaxed text-gray-700">
              <li *ngFor="let weak of codingResult.weaknesses">{{ weak }}</li>
            </ul>
          </article>
        </div>

        <article class="card p-6 bg-white rounded shadow">
          <h3 class="text-lg font-bold text-blue-700 mb-3 border-b pb-2">Areas of Improvement</h3>
          <ul class="list-disc pl-5 leading-relaxed text-gray-700">
            <li *ngFor="let imp of codingResult.improvements">{{ imp }}</li>
          </ul>
        </article>

        <article class="card p-6 bg-white rounded shadow">
          <h3 class="text-lg font-bold mb-4">Interviewer Refactored Code (Optimal Solution)</h3>
          <div class="border rounded overflow-hidden">
            <ngx-monaco-editor class="w-full h-[350px]" [options]="editorReadOnlyOptions" [ngModel]="codingResult.refactored_code"></ngx-monaco-editor>
          </div>
        </article>
      </ng-container>

    </div>
  </ng-container>
</main>
